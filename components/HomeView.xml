    <Label id="row1Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,344]">
    </Label>
    <Label id="row2Time" text="" horizAlign="left" width="210" height="64" translation="[110,440]">
    </Label>
    <Label id="row2Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,434]">
    </Label>
    <Label id="row3Time" text="" horizAlign="left" width="210" height="84" translation="[110,718]">
    </Label>
    <Label id="row3Title" text="" horizAlign="left" width="620" height="94" wrap="true" maxLines="2" translation="[330,712]">
