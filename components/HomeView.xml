<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeView" extends="Group">
  <interface>
    <field id="url" type="string" />
    <field id="mealEntity" type="string" />
    <field id="states" type="assocarray" onChange="onStates" />
    <field id="resolvedEntities" type="assocarray" onChange="onResolvedEntities" />
    <field id="calendarEvents" type="array" onChange="onCalendarEvents" />
    <field id="todayEvents" type="array" onChange="onTodayEvents" />
    <field id="monthCalendar" type="assocarray" onChange="onMonthCalendar" />
    <field id="mealPlan" type="string" onChange="onMealPlan" />
    <field id="weeklyMealPlan" type="array" onChange="onWeeklyMealPlan" />
    <field id="dashboardTitle" type="string" onChange="onDashboardTitle" />
    <field id="themeData" type="assocarray" onChange="onThemeData" />
    <field id="connectionStatus" type="string" onChange="onConnectionStatus" />
    <field id="tabRequest" type="string" alwaysNotify="true" />
    <field id="keyInput" type="string" alwaysNotify="true" onChange="onKeyInput" />
    <field id="activity" type="string" alwaysNotify="true" />
    <field id="restoreFocus" type="string" alwaysNotify="true" />
    <field id="commandRequest" type="assocarray" alwaysNotify="true" />
    <field id="commandResult" type="assocarray" onChange="onCommandResult" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/HomeView.brs" />
