<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeView" extends="Group">
  <interface>
    <field id="url" type="string" />
    <field id="mealEntity" type="string" />
    <field id="states" type="assocarray" onChange="onStates" />
    <field id="resolvedEntities" type="assocarray" onChange="onResolvedEntities" />
    <field id="weatherData" type="assocarray" onChange="onWeatherData" />
    <field id="todayEvents" type="array" onChange="onTodayEvents" />
    <field id="calendarSchedule" type="assocarray" onChange="onCalendarSchedule" />
    <field id="mealPlan" type="string" onChange="onMealPlan" />
    <field id="weeklyMealPlan" type="array" onChange="onWeeklyMealPlan" />
    <field id="dashboardTitle" type="string" onChange="onDashboardTitle" />
    <field id="themeData" type="assocarray" onChange="onThemeData" />
    <field id="connectionStatus" type="string" onChange="onConnectionStatus" />
    <field id="tabRequest" type="string" alwaysNotify="true" />
    <field id="keyInput" type="string" alwaysNotify="true" onChange="onKeyInput" />
    <field id="activity" type="string" alwaysNotify="true" />
    <field id="restoreFocus" type="string" alwaysNotify="true" />
    <field id="commandRequest" type="assocarray" alwaysNotify="true" />
    <field id="commandResult" type="assocarray" onChange="onCommandResult" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/HomeView.brs" />
  <children>
    <Rectangle translation="[50,20]" width="1820" height="112" color="0x241A10F2" />
    <TabIcons selected="home" translation="[70,30]" />
    <Label id="titleLabel" text="FAMILY DASHBOARD" width="500" height="72" translation="[720,43]" font="font:LargeSystemFont" />
    <Label id="dateLabel" text="" horizAlign="right" width="560" height="52" translation="[1270,50]" font="font:MediumSystemFont">
    </Label>
    <Label id="statusLabel" text="" horizAlign="left" width="600" height="36" color="0xE0C89EFF" translation="[720,94]">
    </Label>

    <!-- Calendar panel: today's agenda on the top half, tomorrow's below. -->
    <Rectangle id="calendarRing" translation="[76,166]" width="908" height="838" color="0xE0913EFF" visible="false" />
    <Rectangle id="calendarPanel" translation="[80,170]" width="900" height="830" color="0x241A10F2" />
    <Label id="calendarHeader" text="TODAY'S CALENDAR" horizAlign="left" width="820" height="50" color="0xE0A85EFF" translation="[110,190]" font="font:MediumSystemFont">
    </Label>
    <Poster width="38" height="38" translation="[906,196]" loadDisplayMode="scaleToFit" uri="pkg:/images/mdi/more.png" />

    <Label id="today0Time" text="" horizAlign="left" width="210" height="64" translation="[110,252]">
    </Label>
    <Label id="today0Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,246]">
    </Label>
    <Label id="today1Time" text="" horizAlign="left" width="210" height="64" translation="[110,330]">
    </Label>
    <Label id="today1Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,324]">
    </Label>
    <Label id="today2Time" text="" horizAlign="left" width="210" height="64" translation="[110,408]">
    </Label>
    <Label id="today2Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,402]">
    </Label>
    <Label id="today3Time" text="" horizAlign="left" width="210" height="64" translation="[110,486]">
    </Label>
    <Label id="today3Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,480]">
    </Label>
    <Label id="todayEmpty" text="No events today" horizAlign="left" width="820" height="60" color="0xC0B49CFF" translation="[110,252]">
    </Label>

    <Rectangle translation="[110,570]" width="820" height="2" color="0x806B50FF" />
    <Label id="tomorrowHeader" text="TOMORROW'S CALENDAR" horizAlign="left" width="820" height="46" color="0xE0A85EFF" translation="[110,585]" font="font:MediumSystemFont">
    </Label>
    <Label id="tomorrow0Time" text="" horizAlign="left" width="210" height="64" translation="[110,645]">
    </Label>
    <Label id="tomorrow0Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,639]">
    </Label>
    <Label id="tomorrow1Time" text="" horizAlign="left" width="210" height="64" translation="[110,723]">
    </Label>
    <Label id="tomorrow1Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,717]">
    </Label>
    <Label id="tomorrow2Time" text="" horizAlign="left" width="210" height="64" translation="[110,801]">
    </Label>
    <Label id="tomorrow2Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,795]">
    </Label>
    <Label id="tomorrow3Time" text="" horizAlign="left" width="210" height="64" translation="[110,879]">
    </Label>
    <Label id="tomorrow3Title" text="" horizAlign="left" width="620" height="70" wrap="true" maxLines="2" translation="[330,873]">
    </Label>
    <Label id="tomorrowEmpty" text="No events tomorrow" horizAlign="left" width="820" height="60" color="0xC0B49CFF" translation="[110,645]">
    </Label>

    <!-- Meal panel -->
    <Rectangle id="mealRing" translation="[1016,166]" width="828" height="318" color="0xE0913EFF" visible="false" />
    <Rectangle id="mealPanel" translation="[1020,170]" width="820" height="310" color="0x241A10F2" />
    <Label id="mealHeader" text="MEAL PLAN" horizAlign="left" width="730" height="50" color="0xE0A85EFF" translation="[1050,190]" font="font:MediumSystemFont">
    </Label>
    <Poster width="38" height="38" translation="[1766,196]" loadDisplayMode="scaleToFit" uri="pkg:/images/mdi/settings.png" />
    <Label id="mealContent" text="" horizAlign="left" width="740" height="180" wrap="true" maxLines="4" translation="[1050,258]" font="font:LargeSystemFont">
    </Label>

    <!-- Climate panel -->
    <Rectangle id="climateRing" translation="[1016,496]" width="828" height="508" color="0xE0913EFF" visible="false" />
    <Rectangle id="climatePanel" translation="[1020,500]" width="820" height="500" color="0x241A10F2" />
    <Label id="climateHeader" text="CLIMATE" horizAlign="left" width="730" height="50" color="0xE0A85EFF" translation="[1050,520]" font="font:MediumSystemFont">
    </Label>
    <Rectangle id="climateDivider" translation="[1420,600]" width="2" height="350" color="0x806B50FF" />

    <Label id="insideName" text="Inside" horizAlign="center" width="340" height="48" color="0xE0A85EFF" translation="[1050,600]" font="font:MediumSystemFont">
    </Label>
    <Label id="insideValue" text="--" horizAlign="center" width="340" height="130" translation="[1050,670]" font="font:LargestSystemFont">
    </Label>
    <Label id="insideDetail" text="" horizAlign="center" width="340" height="52" color="0xC0B49CFF" translation="[1050,830]">
    </Label>

    <Label id="outsideName" text="Outside" horizAlign="center" width="340" height="48" color="0xE0A85EFF" translation="[1460,600]" font="font:MediumSystemFont">
    </Label>
    <Poster id="outsideIcon" width="72" height="72" translation="[1594,770]" loadDisplayMode="scaleToFit" uri="pkg:/images/weather/home/unknown.png" />
    <Label id="outsideValue" text="--" horizAlign="center" width="340" height="100" translation="[1460,650]" font="font:LargestSystemFont">
    </Label>
    <Label id="outsideCondition" text="Unknown" horizAlign="center" width="340" height="42" color="0xC0B49CFF" translation="[1460,875]" visible="false" />
    <Label id="outsideDetail" text="" horizAlign="center" width="340" height="38" color="0xC0B49CFF" translation="[1460,875]">
    </Label>

    <Group id="weeklyMeals" visible="false">
      <Rectangle width="1920" height="1080" color="0x100A06FA" />
      <Rectangle translation="[300,120]" width="1320" height="840" color="0x241A10FF" />
      <Label text="WEEKLY MEAL PLAN" width="1180" height="70" translation="[370,165]" color="0xE0A85EFF" />
      <Group id="mealRows" translation="[370,265]" />
      <Label text="Press BACK or LEFT to close" width="1180" height="50" translation="[370,875]" horizAlign="center" color="0xC0B49CFF" />
    </Group>
  </children>
</component>
