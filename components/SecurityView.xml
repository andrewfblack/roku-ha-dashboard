<?xml version="1.0" encoding="utf-8" ?>
<component name="SecurityView" extends="Group">
  <interface>
    <field id="data" type="assocarray" onChange="onData" />
    <field id="tabRequest" type="string" alwaysNotify="true" />
    <field id="commandRequest" type="assocarray" alwaysNotify="true" />
    <field id="commandResult" type="assocarray" onChange="onCommandResult" />
    <field id="keyInput" type="string" alwaysNotify="true" onChange="onKeyInput" />
    <field id="activity" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/SecurityView.brs" />
  <children>
    <Rectangle translation="[50,20]" width="1820" height="112" color="0x241A10F2" />
    <TabIcons id="tabIcons" selected="security" translation="[70,30]" />
    <Label text="SECURITY" width="450" height="72" translation="[800,43]" font="font:LargeSystemFont" />
    <Label id="status" text="OK: control selected item" width="650" height="52" translation="[1190,62]" horizAlign="right" />
    <Rectangle translation="[80,160]" width="1100" height="840" color="0x241A10F2" />
    <Label text="CONTROLS" width="1000" height="52" translation="[120,190]" color="0xE0A85EFF" font="font:MediumSystemFont" />
    <Group id="controls" translation="[120,255]" />
    <Rectangle translation="[1210,160]" width="630" height="840" color="0x241A10F2" />
    <Label text="FAMILY" width="550" height="52" translation="[1250,190]" color="0xE0A85EFF" font="font:MediumSystemFont" />
    <Group id="family" translation="[1250,270]" />
    <Label id="empty" text="Configure security entities in Home Assistant." width="1000" height="70" translation="[120,500]" visible="false" />
    <Label text="LEFT/RIGHT changes tabs   UP/DOWN selects   OK controls" width="1760" height="42" translation="[80,1000]" horizAlign="right" color="0xC0B49CFF" />
  </children>
</component>
