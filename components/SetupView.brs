' Setup requires only a local HA URL and the short code generated by the
' Roku Dashboard integration. No Home Assistant credential is stored on TV.
sub init()
    m.urlButton = m.top.FindNode("urlButton")
    m.codeButton = m.top.FindNode("codeButton")
    m.connectButton = m.top.FindNode("connectButton")
    m.messageButton = m.top.FindNode("messageButton")
    m.url = "http://homeassistant.local:8123"
    m.code = ""
    m.editingField = ""
    m.urlButton.ObserveField("buttonSelected", "onUrlSelected")
    m.codeButton.ObserveField("buttonSelected", "onCodeSelected")
    m.connectButton.ObserveField("buttonSelected", "onConnectSelected")
    renderValues()
    m.urlButton.SetFocus(true)
end sub

sub onPrefill()
    value = m.top.prefill
    if value = invalid then return
    if value.url <> invalid and value.url <> "" then m.url = value.url
    if value.token <> invalid and Len(value.token) <= 16 then m.code = value.token
    renderValues()
end sub

sub onErrorMessage()
    if m.top.errorMessage <> "" then m.messageButton.text = m.top.errorMessage
end sub

sub onInputActive()
    active = m.top.inputActive
    m.urlButton.focusable = active
    m.codeButton.focusable = active
    m.connectButton.focusable = active
    if active
        m.urlButton.SetFocus(true)
    else
        ' Clear focus from the hidden setup button before MainScene takes it.
        m.urlButton.SetFocus(false)
        m.codeButton.SetFocus(false)
        m.connectButton.SetFocus(false)
    end if
end sub

sub renderValues()
    m.urlButton.text = "HOME ASSISTANT URL:  " + m.url
    if m.code = ""
        m.codeButton.text = "PAIRING CODE:  NOT ENTERED"
    else
        m.codeButton.text = "PAIRING CODE:  " + UCase(m.code)
    end if
end sub

sub onUrlSelected()
    openKeyboard("url")
end sub

sub onCodeSelected()
    openKeyboard("code")
end sub

sub openKeyboard(fieldName as string)
    m.editingField = fieldName
    dialog = CreateObject("roSGNode", "KeyboardDialog")
    if dialog = invalid
        m.messageButton.text = "Unable to open Roku keyboard"
        return
    end if
    if fieldName = "url"
        dialog.title = "Enter Home Assistant URL"
        dialog.text = m.url
    else
        dialog.title = "Enter 8-Character Pairing Code"
        dialog.text = m.code
    end if
    dialog.buttons = ["SAVE", "CANCEL"]
    dialog.ObserveField("buttonSelected", "onKeyboardButton")
    m.keyboardDialog = dialog
    m.top.GetScene().dialog = dialog
    dialog.SetFocus(true)
end sub

sub onKeyboardButton()
    dialog = m.keyboardDialog
    if dialog = invalid then return
    if dialog.buttonSelected = 0
        value = dialog.text.Trim()
        if m.editingField = "url"
            m.url = value
        else
            m.code = UCase(value)
        end if
        renderValues()
        m.messageButton.text = "Value saved - select CONNECT"
    end if
    dialog.close = true
    m.keyboardDialog = invalid
    m.urlButton.SetFocus(true)
end sub

sub onConnectSelected()
    url = m.url.Trim()
    code = UCase(m.code.Trim())
    if url = "" or code = ""
        m.messageButton.text = "URL AND PAIRING CODE ARE REQUIRED"
        return
    end if
    if Left(url, 7) <> "http://" and Left(url, 8) <> "https://"
        m.messageButton.text = "URL MUST START WITH http:// OR https://"
        return
    end if
    m.messageButton.text = "CONNECTING..."
    m.top.config = {
        url: url
        token: code
        mealEntity: ""
        insideEntity: ""
        outsideEntity: ""
    }
end sub
