<?xml version="1.0" encoding="utf-8" ?>
<component name="WeatherView" extends="Group">
  <interface>
    <field id="weatherData" type="assocarray" onChange="onWeatherData" />
    <field id="secondaryWeatherData" type="assocarray" onChange="onSecondaryWeatherData" />
    <field id="tabRequest" type="string" alwaysNotify="true" />
    <field id="keyInput" type="string" alwaysNotify="true" onChange="onKeyInput" />
    <field id="activity" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/WeatherView.brs" />
  <children>
    <Rectangle translation="[50,20]" width="1820" height="112" color="0x241A10F2" />
    <TabIcons id="tabIcons" selected="weather" translation="[70,30]" />
    <Label text="WEATHER" width="450" height="72" translation="[720,43]" font="font:LargeSystemFont" />
    <Label id="status" text="Loading weather from Home Assistant..." width="560" height="50" translation="[1280,62]" horizAlign="right" />

    <Rectangle translation="[80,170]" width="540" height="830" color="0x241A10F2" />
    <Label id="weatherName" text="WEATHER" width="470" height="58" color="0xE0A85EFF" translation="[115,205]" font="font:MediumSystemFont" />
    <Poster id="currentIcon" width="176" height="176" translation="[110,275]" loadDisplayMode="scaleToFit" uri="pkg:/images/weather/current/unknown.png" />
    <Label id="currentTemp" text="--" width="280" height="130" translation="[300,285]" font="font:LargestSystemFont" />
    <Label id="currentCondition" text="Unknown" width="460" height="70" translation="[115,465]" font="font:LargeSystemFont" />
    <Label id="currentHumidity" text="" width="460" height="52" translation="[115,565]" />
    <Label id="currentWind" text="" width="460" height="52" translation="[115,630]" />
    <Label id="currentPressure" text="" width="460" height="52" translation="[115,695]" />
    <Label id="currentVisibility" text="" width="460" height="52" translation="[115,760]" />

    <Rectangle translation="[650,170]" width="1190" height="830" color="0x241A10F2" />
    <Label id="forecastHeader" text="FORECAST" width="1110" height="58" color="0xE0A85EFF" translation="[690,205]" font="font:MediumSystemFont" />
    <Label id="secondaryForecastHeader" text="" width="1110" height="48" color="0xE0A85EFF" translation="[690,585]" font="font:MediumSystemFont" visible="false" />
    <Group id="forecastRows" translation="[690,275]" />
    <Label text="Press LEFT to return Home" width="700" height="42" color="0xC0B49CFF" translation="[1100,950]" horizAlign="right" />
  </children>
</component>
